rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function google() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == "google.com"
        && request.auth.token.email_verified == true;
    }
    function email() { return request.auth.token.email.lower(); }
    function admin() { return google() && email() == "geilam@gmail.com"; }
    function dmOf(g) { return google() && (g.owner == request.auth.uid || email() in g.get("dms", [])); }
    function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // each game a DM owns sits in one of five slots: dms/{uid}/slots/{1..5}; the manager has no limit
    function slotOk(n) { return n in ["1", "2", "3", "4", "5"]; }
    function slotPath(uid, n) { return /databases/$(database)/documents/dms/$(uid)/slots/$(n); }
    function dmsOk() { return request.resource.data.get("dms", []) is list && request.resource.data.get("dms", []).size() <= 10; }

    match /games/{code} {
      function game() { return get(/databases/$(database)/documents/games/$(code)).data; }
      // the old all-in-one copy ("json") may only be emptied, by a DM, once the game is split
      function jsonOk() { return !changes().hasAny(["json"]) || request.resource.data.json == ""; }
      allow get: if signedIn();
      allow list: if admin() || dmOf(resource.data);
      allow create: if google() && request.resource.data.owner == request.auth.uid && dmsOk() && !("json" in request.resource.data)
        && (admin() || (slotOk(request.resource.data.get("slot", ""))
            && !exists(slotPath(request.auth.uid, request.resource.data.slot))
            && getAfter(slotPath(request.auth.uid, request.resource.data.slot)).data.game == code));
      // anyone in the game saves the shared part; only the owner (or the manager) renames it or changes its DMs
      allow update: if signedIn() && (
        changes().hasOnly(["pj", "savedAt"])
        || (dmOf(resource.data) && changes().hasOnly(["pj", "savedAt", "json"]) && jsonOk())
        || ((admin() || (google() && resource.data.owner == request.auth.uid))
            && changes().hasOnly(["pj", "savedAt", "json", "name", "dms"]) && jsonOk() && dmsOk())
        // a game made before the slots existed: its owner gives it a free slot, once
        || (google() && resource.data.owner == request.auth.uid && !("slot" in resource.data) && changes().hasOnly(["slot"])
            && slotOk(request.resource.data.slot) && !exists(slotPath(request.auth.uid, request.resource.data.slot))
            && getAfter(slotPath(request.auth.uid, request.resource.data.slot)).data.game == code));
      allow delete: if admin() || (google() && resource.data.owner == request.auth.uid);
      match /por/{cid} {
        allow get, create, update, delete: if signedIn();
        allow list: if admin() || dmOf(game());
      }
      // the DM's part: adventure book progress, the full fight, the monster library
      match /dm/{part} {
        allow read, write: if admin() || dmOf(game());
      }
    }

    // the adventure library: the book document holds only what players may see;
    // the book itself and the DM's pictures open to the uploader, the manager, and every Google DM when the book is "for everyone"
    match /books/{id} {
      function book() { return get(/databases/$(database)/documents/books/$(id)).data; }
      function mine() { return admin() || (google() && book().owner == request.auth.uid); }
      // readers: the DMs of games that use this private book, kept by the book's owner
      function canRead() { return mine() || (google() && (book().everyone == true || email() in book().get("readers", []))); }
      allow get: if signedIn();
      allow list: if admin() || (google() && (resource.data.everyone == true || resource.data.owner == request.auth.uid
        || email() in resource.data.get("readers", [])));
      allow create: if google() && request.resource.data.owner == request.auth.uid && (admin() || request.resource.data.everyone == false);
      allow update: if (admin() || (google() && resource.data.owner == request.auth.uid))
        && request.resource.data.owner == resource.data.owner
        && (admin() || request.resource.data.everyone == resource.data.everyone);
      allow delete: if admin() || (google() && resource.data.owner == request.auth.uid);
      match /pimg/{n} {
        allow get: if signedIn();
        allow create, update, delete: if mine();
      }
      match /dimg/{n} {
        allow get: if canRead();
        allow create, update, delete: if mine();
      }
      match /dm/{n} {
        allow get: if canRead();
        allow create, update, delete: if mine();
      }
    }

    // DMs list: each Google account writes only its own entry, only the manager reads the list
    match /dms/{uid} {
      allow create: if google() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["email", "first", "last", "visits"]) && request.resource.data.email == email();
      allow update: if google() && uid == request.auth.uid
        && changes().hasOnly(["email", "last", "visits"]) && request.resource.data.email == email();
      allow get: if google() && uid == request.auth.uid;
      allow get, list, delete: if admin();
      match /slots/{n} {
        allow get, list: if admin() || (google() && uid == request.auth.uid);
        allow create: if google() && uid == request.auth.uid && slotOk(n) && request.resource.data.keys().hasOnly(["game"])
          && getAfter(/databases/$(database)/documents/games/$(request.resource.data.game)).data.owner == request.auth.uid
          && getAfter(/databases/$(database)/documents/games/$(request.resource.data.game)).data.slot == n;
        // freed only together with its game
        allow delete: if admin() || (google() && uid == request.auth.uid
          && !existsAfter(/databases/$(database)/documents/games/$(resource.data.game)));
      }
    }

    // anonymous visit counting: each device writes its own visits, only the manager reads them
    match /visits/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["t", "end", "dev", "uid", "game", "mode", "kind", "br", "email", "prev"])
        && (request.resource.data.email == "" || (google() && request.resource.data.email == email()));
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && changes().hasOnly(["end", "game", "mode"]);
      allow read, delete: if admin();
    }
  }
}
