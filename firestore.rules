rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == "geilam@gmail.com";
    }
    match /games/{code} {
      allow get: if signedIn();
      allow list, create, delete: if admin();
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["json", "savedAt"]);
      match /por/{cid} {
        allow get, create, update, delete: if signedIn();
        allow list: if admin();
      }
    }
  }
}
