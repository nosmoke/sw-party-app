rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function google() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == "google.com"
        && request.auth.token.email_verified == true;
    }
    function email() { return request.auth.token.email.lower(); }
    function admin() { return google() && email() == "geilam@gmail.com"; }
    function dmOf(g) { return google() && (g.owner == request.auth.uid || email() in g.get("dms", [])); }
    function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function dmsOk() { return request.resource.data.get("dms", []) is list && request.resource.data.get("dms", []).size() <= 10; }

    match /games/{code} {
      allow get: if signedIn();
      allow list: if admin() || dmOf(resource.data);
      allow create: if google() && request.resource.data.owner == request.auth.uid && dmsOk();
      // anyone in the game saves the party; only the owner (or the manager) renames it or changes its DMs
      allow update: if signedIn() && (
        changes().hasOnly(["json", "savedAt"])
        || ((admin() || (google() && resource.data.owner == request.auth.uid))
            && changes().hasOnly(["json", "savedAt", "name", "dms"]) && dmsOk()));
      allow delete: if admin() || (google() && resource.data.owner == request.auth.uid);
      match /por/{cid} {
        allow get, create, update, delete: if signedIn();
        allow list: if admin() || dmOf(get(/databases/$(database)/documents/games/$(code)).data);
      }
    }

    // DMs list: each Google account writes only its own entry, only the manager reads the list
    match /dms/{uid} {
      allow create: if google() && uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["email", "first", "last", "visits"]) && request.resource.data.email == email();
      allow update: if google() && uid == request.auth.uid
        && changes().hasOnly(["email", "last", "visits"]) && request.resource.data.email == email();
      allow get: if google() && uid == request.auth.uid;
      allow get, list, delete: if admin();
    }

    // anonymous visit counting: each device writes its own visits, only the manager reads them
    match /visits/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["t", "end", "dev", "uid", "game", "mode", "kind", "br", "email"])
        && (request.resource.data.email == "" || (google() && request.resource.data.email == email()));
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && changes().hasOnly(["end", "game", "mode"]);
      allow read, delete: if admin();
    }
  }
}
